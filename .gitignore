# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/
*-env/

# Data (proprietary / generated) - only the folder skeleton is versioned
data/images/*
!data/images/raw/
data/images/raw/*
!data/images/raw/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/overlap_thresholds.json
coco_dataset/*
!coco_dataset/.gitkeep
results/*
!results/.gitkeep

# Generated configuration
configs/data.yaml

# Model weights
*.pt
*.pth
*.onnx

# Per-class auto-labeling parameters (may contain confidential class names); only the template is versioned
configs/Labeling_yaml_config/*
!configs/Labeling_yaml_config/example_class_labeling_parameters.yaml
